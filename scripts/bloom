#!/bin/sh
# Start Bloom: runs the daemon unless one is already answering, then opens the TUI.
# The default is the optimized release profile; pass --debug for the debug profile.
#
# Everything is discovered automatically: the OpenBubbles Flatpak provides the
# engine library and state, the sidecar script lives in this repository, and Dart
# is taken from PATH or a user-local SDK. Override with BLOOM_ENGINE_STATE,
# BLOOM_ENGINE_LIBRARY, BLOOM_ENGINE_SCRIPT, BLOOM_DART_EXECUTABLE or
# BLOOM_SOCKET_PATH, normally by putting them in a .env file next to this script.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

profile=release
usage() {
  cat <<'EOF'
usage: scripts/bloom [--release|--debug]
  --release  build and run the optimized daemon and TUI (default)
  --debug    build and run the debug daemon and TUI
EOF
}
if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi
case "${1:-}" in
  "") ;;
  --release) profile=release ;;
  --debug) profile=debug ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

# Local overrides live in .env so your shell stays clean. Only paths belong there,
# never secrets. The file is sourced, so it must be trusted like any shell script.
if [ -f "$root/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$root/.env"
  set +a
fi

# Dart is often installed per-user rather than system-wide.
if ! command -v dart >/dev/null 2>&1; then
  for candidate in "$HOME/.cache/dart-sdk/dart-sdk/bin" "$HOME/.local/share/bloom/dart/bin"; do
    if [ -x "$candidate/dart" ]; then
      PATH="$candidate:$PATH"
      export PATH
      break
    fi
  done
fi

socket=${BLOOM_SOCKET_PATH:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bloom/bloomd.sock}
export BLOOM_SOCKET_PATH="$socket"
log="${XDG_STATE_HOME:-$HOME/.local/share}/bloom/bloomd.log"

echo "building bloom ($profile profile)..." >&2
if [ "$profile" = release ]; then
  CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2} cargo build --release -p bloomd -p bloom-tui
  bin_dir=target/release
else
  CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2} cargo build -p bloomd -p bloom-tui
  bin_dir=target/debug
fi

# A leftover socket file from a crashed daemon must not be mistaken for a live one,
# so probe by connecting rather than testing for the file.
daemon_answers() {
  "$root/scripts/bloom-probe" "$socket"
}

started_daemon=""
if ! daemon_answers; then
  mkdir -p "$(dirname "$log")"
  # Keep daemon diagnostics out of the TUI: they would overwrite the screen.
  "$bin_dir/bloomd" >>"$log" 2>&1 &
  started_daemon=$!
  echo "bloom: daemon started ($profile profile), log at $log" >&2

  i=0
  while ! daemon_answers; do
    i=$((i + 1))
    if [ "$i" -gt 200 ]; then
      echo "bloom: daemon never started listening; last log lines:" >&2
      tail -20 "$log" >&2 || true
      exit 1
    fi
    if ! kill -0 "$started_daemon" 2>/dev/null; then
      echo "bloom: daemon exited during startup; last log lines:" >&2
      tail -20 "$log" >&2 || true
      exit 1
    fi
    sleep 0.1
  done
else
  echo "bloom: reusing the existing daemon at $socket" >&2
fi

cleanup() {
  if [ -n "$started_daemon" ]; then
    kill "$started_daemon" 2>/dev/null || true
    wait "$started_daemon" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

"$bin_dir/bloom-tui"
