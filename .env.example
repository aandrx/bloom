# Optional Bloom overrides. Copy to .env and edit; .env is gitignored.
#
# Bloom discovers all of these automatically on a normal single-machine setup, so
# you only need an entry here when your layout differs.

# OpenBubbles state directory (registration and keys).
# BLOOM_ENGINE_STATE="$HOME/.var/app/app.openbubbles.OpenBubbles/data/bluebubbles"

# Engine library inside the installed Flatpak.
# BLOOM_ENGINE_LIBRARY="$(flatpak info --show-location app.openbubbles.OpenBubbles)/files/bluebubbles/lib/librust_lib_bluebubbles.so"

# Sidecar entry point.
# BLOOM_ENGINE_SCRIPT="$PWD/ext/bloom-engine-sidecar/dart/bin/bloom_engine.dart"

# Dart executable, if it is not on PATH.
# BLOOM_DART_EXECUTABLE="$HOME/.cache/dart-sdk/dart-sdk/bin/dart"

# Daemon socket and store locations.
# BLOOM_SOCKET_PATH="$XDG_RUNTIME_DIR/bloom/bloomd.sock"
# BLOOM_STORE_PATH="$HOME/.local/share/bloom/store.db"
