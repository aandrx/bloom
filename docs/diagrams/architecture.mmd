%% Current architecture. See ../system-design.md and ../handoff.md.
flowchart TB
    LAUNCH["Installed bloom launcher"] --> TUI["bloom-tui: terminal interaction"]
    LAUNCH --> DAEMON["bloomd: owned daemon or reused listener"]
    TUI <-->|"Authenticated bounded Unix-socket IPC"| DAEMON
    DAEMON --> STORE[("Encrypted SQLite: conversations and messages")]
    KEY["OS keychain: database key"] --> STORE
    DAEMON <-->|"Version-1 JSON lines over stdio"| DART["Headless Dart sidecar: explicit codec and coordination"]
    DART --> ENGINE["External installed OpenBubbles engine library"]
    STATE[("Existing registration: exclusive owner")] --> ENGINE
    ENGINE <-->|"Existing engine transport"| APPLE["Apple services"]
    GPUI["GPUI: deferred, not implemented"] -.->|"Future IPC client"| DAEMON
    IDS["Independent registration: Gate 0 blocked"]
    HISTORY["Remote message import: not implemented"]
    RESTART["Automatic engine restart: not implemented"]
