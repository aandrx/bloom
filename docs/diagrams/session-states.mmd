%% Current single-use Session lifecycle and mapped engine labels, not a sign-in/renewal implementation.
stateDiagram-v2
    state "Daemon Session lifecycle" as Lifecycle {
        [*] --> New
        New --> Running: transport start succeeds
        New --> Stopped: start fails and cleanup runs
        Running --> Stopped: explicit stop cancels calls and stops transport
        Stopped --> [*]
    }
    note right of Running
        Child failure reports disconnected.
        No automatic new generation or send replay.
        Restart design must construct a fresh Session.
    end note
    state "Mapped engine-reported labels" as Reported {
        Unregistered
        Activating
        Registered
        Active
        RenewalDue
        Renewing
        Throttled
        Blocked
        Failed
        Disconnected
    }
    note right of Reported
        Labels map engine events, not enforced transitions.
        Unknown labels map to Disconnected.
        They do not prove Bloom-owned activation or renewal.
    end note
